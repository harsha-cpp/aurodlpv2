# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# uv
.uv/
# uv.lock IS committed: these are applications, not libraries, and an
# unlocked CI checkout re-resolves dependencies, so builds would not be
# reproducible and a transitive bump could ship unreviewed.
# uv.lock

# Node / pnpm
node_modules/
.pnpm-store/
pnpm-debug.log*
npm-debug.log*
.yarn/
.next/
.turbo/

# Vite / bundlers
**/dist/
**/.vite/
*.tsbuildinfo

# Chrome extension build outputs
frontend/packages/extension/dist/
frontend/packages/extension/.crx/

# Playwright
playwright-report/
test-results/
.playwright/

# Env / secrets
.env
# docs/deployment.md tells operators to create this from backend/.env.example
# and fill it with real secrets, so it must never be committable.
infra/*.env
.env.*
# ...but every *.example template must ship: docs/deployment.md tells the
# operator to copy them, and `.env.*` above was silently swallowing
# infra/.env.prod.example, so a fresh clone had nothing to copy.
!.env.example
!*.env.example
!.env.*.example
*.pem
*.key
*.crt

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~

# Sisyphus / opencode scratch
.sisyphus/
.kiro/

# Attachment scratch
tmp/
/tmp-medshield/

# Docker / data volumes
infra/data/
*.timestamp-*.mjs

# Scratch and build artefacts
*.pyc
*.tmp.mjs
*.tmp.py
*.tmp.ts
