# Auro Healthcare DLP backend - copy to .env and adjust
APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=json

# HTTP
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,chrome-extension://EXTENSION_ID_HERE

# Database (asyncpg DSN)
DATABASE_URL=postgresql+asyncpg://aurodlpv2:aurodlpv2@localhost:5433/aurodlpv2
# Sync DSN for Alembic
DATABASE_SYNC_URL=postgresql+psycopg://aurodlpv2:aurodlpv2@localhost:5433/aurodlpv2

# Redis (distributed login throttling)
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-32-bytes-min
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOGIN_RATE_LIMIT_PER_HOUR=20
EXTENSION_TOKEN_TTL_DAYS=365

# Attachment scan pipeline
ATTACHMENT_TEMP_DIR=/tmp/aurodlpv2-attachments
ATTACHMENT_MAX_BYTES=26214400  # 25 MB
SCAN_DEEP_SCAN_THRESHOLD_BYTES=10485760  # 10 MB or images -> durable worker
OBJECT_STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
OBJECT_STORAGE_ACCESS_KEY=aurodlpv2
OBJECT_STORAGE_SECRET_KEY=aurodlpv2-secret
OBJECT_STORAGE_BUCKET=aurodlpv2-quarantine
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_SSE=none
OBJECT_STORAGE_RETENTION_DAYS=1
SCAN_WORKER_POLL_SECONDS=1
SCAN_WORKER_LEASE_SECONDS=300
SCAN_WORKER_MAX_ATTEMPTS=5

# Observability
SENTRY_DSN=
