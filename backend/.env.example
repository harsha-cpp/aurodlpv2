# MedShield backend - copy to .env and adjust
APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=json

# HTTP
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,chrome-extension://EXTENSION_ID_HERE

# Database (asyncpg DSN)
DATABASE_URL=postgresql+asyncpg://medshield:medshield@localhost:5432/medshield
# Sync DSN for Alembic
DATABASE_SYNC_URL=postgresql+psycopg://medshield:medshield@localhost:5432/medshield

# Redis (Celery broker + cache)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Auth
GOOGLE_CLIENT_IDS=YOUR_CHROME_EXT_OAUTH_CLIENT_ID.apps.googleusercontent.com
ALLOWED_HD_DOMAINS=hospital.example.org
JWT_SECRET=change-me-32-bytes-min
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Temp file pipeline
ATTACHMENT_TEMP_DIR=/tmp/medshield-attachments
ATTACHMENT_MAX_BYTES=26214400  # 25 MB
ATTACHMENT_DEEP_SCAN_THRESHOLD=2097152  # 2 MB -> Celery

# Object storage (quarantine vault) - MinIO compatible
QUARANTINE_BUCKET=medshield-quarantine
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=medshield
S3_SECRET_KEY=medshield-secret
S3_REGION=us-east-1

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9100
SENTRY_DSN=
