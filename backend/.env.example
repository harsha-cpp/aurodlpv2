# ===========================================================================
# Auro Healthcare DLP — backend configuration reference
#
# Every field on Settings (backend/aurodlpv2_backend/settings.py) appears below
# with its real default. Copy this file and edit:
#
#   local dev   :  cp backend/.env.example backend/.env
#   docker prod :  cp backend/.env.example infra/api.env
#                  (infra/docker-compose.prod.yml OVERRIDES the connection
#                   strings and every secret from infra/.env — see the
#                   "MANAGED BY COMPOSE" markers below)
#
# The values here are the LOCAL DEVELOPMENT defaults. Lines marked
#   *** PRODUCTION: ... ***
# must be changed before APP_ENV=production, and four of them are enforced:
# Settings.enforce_production_security() refuses to construct — so the app will
# not boot at all — when APP_ENV=production and any of these is true:
#
#   1. REFRESH_COOKIE_SECURE is false
#   2. JWT_SECRET starts with "change-me"
#   3. STORAGE_BACKEND is "local"
#   4. MAILER_BACKEND is "console"
#
# LIST-VALUED SETTINGS MUST BE JSON. pydantic-settings JSON-decodes list fields
# straight from the environment, before settings.py's comma-splitting validator
# runs, so `CORS_ORIGINS=https://a,https://b` raises at startup and an empty
# value does too. Write `["https://a","https://b"]`, or `[]` for none. This
# affects CORS_ORIGINS and API_RATE_LIMIT_EXEMPT_PATHS.
# ===========================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# "local" | "production" (anything else is treated as non-production). Setting
# this to production turns on the four hard checks above and hides /docs.
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# "json" for shippable logs, anything else for human-readable console output.
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Only used if you start uvicorn from Settings; the container CMD passes its own.
API_HOST=0.0.0.0
API_PORT=8000
# JSON array of dashboard origins allowed to call the API with credentials.
# *** PRODUCTION: set to your dashboard's https origin. *** MANAGED BY COMPOSE ***
CORS_ORIGINS=["http://localhost:5173"]

# ---------------------------------------------------------------------------
# Database                                              *** MANAGED BY COMPOSE ***
# ---------------------------------------------------------------------------
# Two URLs for one database: the app runs on asyncpg, alembic runs on psycopg.
# They must point at the same place or migrations land in the wrong database.
DATABASE_URL=postgresql+asyncpg://aurodlpv2:aurodlpv2@localhost:5433/aurodlpv2
DATABASE_SYNC_URL=postgresql+psycopg://aurodlpv2:aurodlpv2@localhost:5433/aurodlpv2
# Per-process pool. Total connections = (pool + overflow) x api replicas
# x uvicorn workers, plus the Celery workers. Postgres' default max_connections
# is 100; size these so the sum stays under it.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
# Required true behind a transaction-mode pooler (PgBouncer, Neon, Supabase),
# where a prepared statement from one transaction is invisible to the next.
# Harmless but slightly slower against a direct Postgres connection.
DATABASE_DISABLE_PREPARED_STATEMENTS=true

# ---------------------------------------------------------------------------
# Redis / Celery                                        *** MANAGED BY COMPOSE ***
# ---------------------------------------------------------------------------
# Used by the readiness probe and the API rate limiter.
REDIS_URL=redis://localhost:6379/0
# Queue. Keep the result backend on a different database number so a
# `FLUSHDB` on results cannot drop queued scans.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# *** PRODUCTION: use redis://:PASSWORD@host:6379/0 — an unauthenticated Redis
# reachable from anywhere is a full read of every queued attachment. ***

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signs access and refresh tokens. Rotating it logs every user out immediately.
# *** PRODUCTION (ENFORCED): must not start with "change-me". ***
#   openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=change-me-change-me-change-me-32!
JWT_ALGORITHM=HS256
# Short access token; the dashboard refreshes silently. 900s = 15 minutes.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
REFRESH_COOKIE_NAME=aurodlpv2_refresh
# *** PRODUCTION (ENFORCED): must be true. The refresh cookie is a 30-day
# credential; without Secure it goes out over plain HTTP. ***
REFRESH_COOKIE_SECURE=false
# lax | strict | none. "none" is required when the dashboard and the API are on
# different hostnames (and browsers only accept it together with Secure).
REFRESH_COOKIE_SAMESITE=lax
# Per-IP login throttle. Low on purpose: these are password attempts.
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOGIN_RATE_LIMIT_PER_HOUR=20
# How many proxies append to X-Forwarded-For between the browser and the API.
# 0 = the API is directly exposed. 1 = one nginx/Caddy/ALB in front.
# *** PRODUCTION: get this right. Too low and every hospital shares one rate-limit
# bucket (one attacker locks out a whole tenant); too high and a client can forge
# its own source IP and bypass the throttle entirely. ***
TRUSTED_PROXY_COUNT=0
# Self-serve tenant creation.
# *** PRODUCTION: false for hospital installs — operators create the org and
# staff join by invite. ***
ALLOW_OPEN_SIGNUP=true
# Two dashboard tabs can refresh at the same moment. A rotated refresh token
# stays valid this long before a reuse is treated as token theft.
REFRESH_ROTATION_GRACE_SECONDS=60
PASSWORD_RESET_TTL_SECONDS=3600
EMAIL_VERIFICATION_TTL_HOURS=24
# How long an enrolled extension install stays trusted before re-enrolling.
DEVICE_TOKEN_TTL_DAYS=365
# Shown in the user's authenticator app next to the TOTP code.
MFA_ISSUER=Auro Healthcare DLP
# Encrypts TOTP seeds at rest, so a database dump does not hand over MFA.
#
# Left COMMENTED OUT deliberately. settings.py falls back to JWT_SECRET when this
# is UNSET, but an env var set to the empty string is not unset: it becomes
# SecretStr('') and the fallback never runs, so TOTP seeds get encrypted with an
# empty key. Either give it a real value or leave the line commented.
# *** PRODUCTION: set a second, independent secret — sharing JWT_SECRET means
# rotating the JWT secret locks every user out of MFA. ***
#   openssl rand -base64 48 | tr -d '\n'
#MFA_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# API rate limiting (RateLimitMiddleware)
# ---------------------------------------------------------------------------
# Per key (IP, or authenticated principal) per minute, shared across processes
# through Redis. High because a hospital behind one NAT address puts every
# workstation on a single key.
API_RATE_LIMIT_PER_MINUTE=600
# JSON array. Paths excluded from the global limit because they have their own
# per-device limits. Leave unset to keep the built-in default.
API_RATE_LIMIT_EXEMPT_PATHS=["/api/v1/scan","/api/v1/events"]
# Ceiling on the in-memory fallback used when Redis is unreachable, so a spray
# of unique keys cannot exhaust a worker's memory.
API_RATE_LIMIT_MAX_KEYS=10000

# ---------------------------------------------------------------------------
# Outbound mail
# ---------------------------------------------------------------------------
# console | smtp. "console" writes the mail to the log and delivers nothing.
# *** PRODUCTION (ENFORCED): must be smtp — invites, password resets and email
# verification are all undeliverable otherwise. ***
MAILER_BACKEND=console
SMTP_HOST=localhost
# 587 for STARTTLS (with SMTP_TLS=true), 465 for implicit TLS, 1025 for MailHog.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Auro Healthcare DLP <no-reply@localhost>
SMTP_TLS=true
# Public URL of the DASHBOARD. Invite / reset / verification links are built from
# it, so a wrong value produces mail nobody can act on.
# *** PRODUCTION: set to the dashboard's https URL. ***
APP_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Attachments and object storage
# ---------------------------------------------------------------------------
# Scratch directories. Created at startup and chmod 0700, so the runtime user
# must own them. The container images set these to /var/lib/aurodlp/*.
ATTACHMENT_TEMP_DIR=/tmp/aurodlpv2-attachments
QUARANTINE_STORAGE_DIR=/tmp/aurodlpv2-quarantine
# Attachments larger than this skip the inline scan and go to the Celery queue.
SCAN_DEEP_SCAN_THRESHOLD_BYTES=10485760
# local | s3.
# *** PRODUCTION (ENFORCED): must be s3. "local" requires the API and the Celery
# worker to share a filesystem, so a queued attachment written by the API is
# simply missing when a worker on another host tries to read it. ***
STORAGE_BACKEND=local
# --- s3 backend (also MinIO / any S3-compatible store) --- MANAGED BY COMPOSE ---
S3_BUCKET=aurodlpv2-attachments
# Key prefix inside the bucket.
S3_PREFIX=queued-scans
S3_REGION=ap-south-1
# Set for MinIO (http://minio:9000). Leave EMPTY for real AWS S3.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# AES256 or aws:kms on real S3. MUST BE EMPTY for MinIO, which rejects the
# server-side-encryption header with 400 unless KMS is configured.
S3_SERVER_SIDE_ENCRYPTION=AES256

# ---------------------------------------------------------------------------
# Scan execution
# ---------------------------------------------------------------------------
# Detection is CPU-bound and synchronous, so it runs in a bounded thread pool
# instead of on the event loop. Set at or below the container's CPU limit;
# higher just adds queueing latency. Range 1-64.
SCAN_MAX_CONCURRENCY=4
# /api/v1/scan and /api/v1/events are exempt from the IP-keyed global limiter,
# because a whole hospital shares one NAT address. Their budget is keyed on the
# credential instead. Per enrolled extension install:
SCAN_RATE_LIMIT_PER_DEVICE_PER_MINUTE=60
# ...and per organisation, as a ceiling across all of its devices.
SCAN_RATE_LIMIT_PER_ORG_PER_MINUTE=600

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Empty disables Sentry. Note the DSN is not itself a secret, but the events it
# carries can contain patient data — check your scrubbing before enabling.
SENTRY_DSN=
