{
  "name": "aurodlpv2-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Auro Healthcare DLP Chrome extension + admin dashboard. See docs/plans/frontend.md.",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=11.20.0"
  },
  "scripts": {
    "dev:extension": "pnpm --filter @aurodlpv2/extension dev",
    "dev:dashboard": "pnpm --filter @aurodlpv2/dashboard dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @aurodlpv2/extension test:e2e",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.5",
    "eslint": "^10.4.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.3"
  }
}
