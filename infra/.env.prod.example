# ---------------------------------------------------------------------------
# infra/.env — compose-level configuration for infra/docker-compose.prod.yml
#
#   cp infra/.env.prod.example infra/.env    &&    edit
#   cp backend/.env.example    infra/api.env &&    edit
#
# This file holds the values compose itself interpolates: credentials it has to
# hand to postgres/redis/minio AND to the backend, plus image tags and ports.
# infra/api.env holds the rest of the application settings.
#
# The split exists so a password is written once. compose derives DATABASE_URL,
# REDIS_URL and the S3 credentials from the values here and injects them into the
# backend containers, overriding anything api.env says about them.
#
# chmod 600 infra/.env. It is gitignored (.env.* is), but check before committing.
# ---------------------------------------------------------------------------

# --- Images ----------------------------------------------------------------
# Registry/namespace and tag. Use an immutable tag (a git sha) in production;
# `latest` makes a rollback ambiguous.
IMAGE_PREFIX=blade
IMAGE_TAG=latest

# --- Secrets — GENERATE THESE, do not ship the examples ---------------------
# openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=CHANGE-ME-generate-with-openssl-rand-base64-48
# openssl rand -base64 32 | tr -d '/+=' | head -c 40
POSTGRES_PASSWORD=CHANGE-ME
REDIS_PASSWORD=CHANGE-ME
MINIO_ROOT_PASSWORD=CHANGE-ME-at-least-8-chars

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=blade
POSTGRES_DB=blade

# --- Object storage ---------------------------------------------------------
MINIO_ROOT_USER=blade
S3_BUCKET=blade-attachments
S3_REGION=ap-south-1
# Leave as-is for the bundled MinIO. For real AWS S3: set S3_ENDPOINT_URL empty,
# set S3_REGION to the bucket's region, and replace MINIO_ROOT_USER/PASSWORD with
# an IAM access key scoped to that one bucket.
S3_ENDPOINT_URL=http://minio:9000
# MinIO returns 400 for the AWS server-side-encryption header unless KMS is
# configured. Empty for MinIO; AES256 (or aws:kms) for S3.
S3_SERVER_SIDE_ENCRYPTION=
# The MinIO web console is an admin surface with root credentials. Leave off.
MINIO_BROWSER=off

# --- Public URLs ------------------------------------------------------------
# The API's CORS allow-list: the origin(s) the dashboard is served from.
#
# !! MUST BE A JSON ARRAY !!  settings.py declares cors_origins as list[str], and
# pydantic-settings 2.14 JSON-decodes complex fields straight out of the
# environment — before the CSV-splitting validator in settings.py ever runs. So
# `https://x` and `https://x,https://y` both crash the app at import with
# `error parsing value for field "cors_origins"`, and an EMPTY value crashes it
# too. Write JSON, including for a single origin, and use [] for none.
# (Verified against pydantic-settings 2.14.1. If the backend later annotates the
# field with NoDecode, the comma form will start working; JSON will keep working.)
CORS_ORIGINS=["https://dlp.hospital.example"]
# Where the browser reaches the API. BAKED INTO THE DASHBOARD IMAGE AT BUILD
# TIME (Vite inlines it, and it becomes the CSP connect-src) — changing it
# requires `docker compose -f infra/docker-compose.prod.yml build dashboard`.
VITE_API_BASE_URL=https://dlp-api.hospital.example

# The dashboard and the API are on different hostnames in the setup above, so the
# refresh cookie has to be SameSite=None (which the browser only accepts with
# Secure, which production already enforces). Set to `lax` if you put both behind
# one hostname with a path-based split — that is the safer configuration.
REFRESH_COOKIE_SAMESITE=none

# --- Host ports (bound to 127.0.0.1; put a TLS reverse proxy in front) -------
API_PORT=8000
DASHBOARD_PORT=8081

# --- Outbound mail ----------------------------------------------------------
# MAILER_BACKEND is forced to `smtp` by the compose file: the app refuses to boot
# in production with the console backend, because invites, password resets and
# email verification all become undeliverable.
SMTP_HOST=smtp.hospital.example
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Blade DLP <no-reply@hospital.example>
SMTP_TLS=true

# Public URL of the DASHBOARD. Invite / reset / verify links in outgoing mail are
# built from this, so it must be the address a user's browser can actually reach
# (usually the same value as CORS_ORIGINS, without the JSON brackets).
APP_BASE_URL=https://dlp.hospital.example

# --- Auth / tenancy ---------------------------------------------------------
# Second independent secret: TOTP seeds are encrypted with it. If unset the app
# falls back to JWT_SECRET, which couples MFA to the JWT rotation schedule.
# openssl rand -base64 48 | tr -d '\n'
MFA_ENCRYPTION_KEY=CHANGE-ME-a-second-independent-secret

# How many proxies append to X-Forwarded-For between the browser and the API.
# 1 = one reverse proxy on the host (the layout this compose file assumes).
# 0 makes every request look like it came from the proxy, so all hospitals share
# one login-rate-limit bucket. Too high lets a client forge its own source IP.
TRUSTED_PROXY_COUNT=1

# Self-serve tenant signup. Closed for hospital installs; operators create the
# organisation and staff join by invite.
ALLOW_OPEN_SIGNUP=false

# --- Workers ----------------------------------------------------------------
# Detection is CPU-bound. Keep concurrency <= the cpu limit on the worker service.
WORKER_CONCURRENCY=4
WORKER_REPLICAS=1

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
SENTRY_DSN=
